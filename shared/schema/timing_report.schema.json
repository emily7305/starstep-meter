{
  "$defs": {
    "AudioSource": {
      "additionalProperties": false,
      "properties": {
        "codec": {
          "description": "codec of the first audio stream as ffprobe names it, e.g. mp3, aac, vorbis",
          "title": "Codec",
          "type": "string"
        },
        "decoder_padding_samples": {
          "description": "samples a decoder that ignores gapless info plays before ffmpeg's first sample, 0 if not applicable",
          "minimum": 0,
          "title": "Decoder Padding Samples",
          "type": "integer"
        },
        "duration_ms": {
          "description": "length of the decoded audio",
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "filename": {
          "description": "original upload name, for display only",
          "title": "Filename",
          "type": "string"
        },
        "sample_rate": {
          "description": "sample rate of the decoded audio in Hz",
          "exclusiveMinimum": 0,
          "title": "Sample Rate",
          "type": "integer"
        },
        "sha256": {
          "description": "sha256 of the original file, not the decoded wav",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "sha256",
        "duration_ms",
        "sample_rate",
        "codec",
        "decoder_padding_samples"
      ],
      "title": "AudioSource",
      "type": "object"
    },
    "Edit": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "the deepest path that holds everything the change touched, e.g. tempo_map/0/bpm. with one changed value old and new are that value, with several they're objects keyed by each value's path under field, and an empty field is the report itself",
          "title": "Field",
          "type": "string"
        },
        "new": {
          "$ref": "#/$defs/JsonValue"
        },
        "old": {
          "$ref": "#/$defs/JsonValue"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "field",
        "old",
        "new",
        "timestamp"
      ],
      "title": "Edit",
      "type": "object"
    },
    "JsonValue": {},
    "MeterSegment": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "denominator": {
          "maximum": 64,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "end_ms": {
          "description": "where it stops, the same value as the next meter segment's start_ms",
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "numerator": {
          "maximum": 32,
          "minimum": 1,
          "title": "Numerator",
          "type": "integer"
        },
        "source": {
          "enum": [
            "auto",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "start_ms": {
          "description": "where this meter starts, the first starts at tempo_map[0].start_ms. inside a tempo segment it's a bar line and bars restart there, at a tempo segment's start the segment's anchor is bar 1",
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "numerator",
        "denominator",
        "confidence",
        "source"
      ],
      "title": "MeterSegment",
      "type": "object"
    },
    "NotationSuggestion": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "grid_bpm": {
          "description": "bpm of the tempo segment the suggestion was made on",
          "exclusiveMinimum": 0,
          "title": "Grid Bpm",
          "type": "number"
        },
        "kind": {
          "description": "half: the span feels like half the grid's tempo, double: twice it, fold: a first or last stretch that may be its neighbour's tempo the analysis didn't fold in",
          "enum": [
            "half",
            "double",
            "fold"
          ],
          "title": "Kind",
          "type": "string"
        },
        "score": {
          "description": "how clear the evidence is, 1 is as clear as it gets",
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "start_ms": {
          "description": "a bar line, or the start of the tempo segment for a fold",
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "applied",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "suggested_bpm": {
          "exclusiveMinimum": 0,
          "title": "Suggested Bpm",
          "type": "number"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "kind",
        "suggested_bpm",
        "grid_bpm",
        "score",
        "status"
      ],
      "title": "NotationSuggestion",
      "type": "object"
    },
    "OffbeatRun": {
      "additionalProperties": false,
      "properties": {
        "beats": {
          "description": "tracked beats in the run",
          "minimum": 1,
          "title": "Beats",
          "type": "integer"
        },
        "end_ms": {
          "description": "last tracked beat of the run",
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "start_ms": {
          "description": "first tracked beat of the run",
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "beats"
      ],
      "title": "OffbeatRun",
      "type": "object"
    },
    "RatioMergedSection": {
      "additionalProperties": false,
      "properties": {
        "bpm": {
          "description": "what the stretch fitted to on its own",
          "exclusiveMinimum": 0,
          "title": "Bpm",
          "type": "number"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "fit": {
          "description": "share of its beats on the segment's grid (lines, halves, thirds) over the share on its own grid",
          "minimum": 0,
          "title": "Fit",
          "type": "number"
        },
        "ratio": {
          "description": "its bpm over the segment's, near enough, e.g. 3/4 for a triplet feel or 2/3 for a dotted one",
          "pattern": "^[1-9][0-9]*/[1-9][0-9]*$",
          "title": "Ratio",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "bpm",
        "ratio",
        "fit"
      ],
      "title": "RatioMergedSection",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "source": {
          "enum": [
            "auto",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        }
      },
      "required": [
        "label",
        "start_ms",
        "end_ms",
        "source"
      ],
      "title": "Section",
      "type": "object"
    },
    "TempoSegment": {
      "additionalProperties": false,
      "properties": {
        "anchor_ms": {
          "description": "a downbeat on this segment's grid, which is anchor_ms + k * 60000 / bpm. the first segment's anchor is the song's first downbeat",
          "title": "Anchor Ms",
          "type": "number"
        },
        "bpm": {
          "exclusiveMinimum": 0,
          "title": "Bpm",
          "type": "number"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_ms": {
          "description": "where it stops, the same value as the next segment's start_ms",
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "ratio_merged": {
          "description": "felt tempo sections (dotted, triplet feel) inside this segment that the analysis kept on its grid, splitting at a section's start_ms and end_ms gives it back its own tempo",
          "items": {
            "$ref": "#/$defs/RatioMergedSection"
          },
          "title": "Ratio Merged",
          "type": "array"
        },
        "source": {
          "enum": [
            "auto",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "start_ms": {
          "description": "where this tempo starts, the first segment starts at trim.start_ms",
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "bpm",
        "anchor_ms",
        "confidence",
        "source",
        "ratio_merged"
      ],
      "title": "TempoSegment",
      "type": "object"
    },
    "Trim": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "description": "end of the last audible sound",
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "start_ms": {
          "description": "first audible sound",
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "Trim",
      "type": "object"
    }
  },
  "$id": "timing_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edits": {
      "items": {
        "$ref": "#/$defs/Edit"
      },
      "title": "Edits",
      "type": "array"
    },
    "meter_map": {
      "items": {
        "$ref": "#/$defs/MeterSegment"
      },
      "title": "Meter Map",
      "type": "array"
    },
    "notation_suggestions": {
      "description": "places where a chart may write the pulse at another tempo (half or double time feel) or fold an edge into its neighbour. never applied by the analysis, an edit applies or dismisses each one",
      "items": {
        "$ref": "#/$defs/NotationSuggestion"
      },
      "title": "Notation Suggestions",
      "type": "array"
    },
    "offbeat_runs": {
      "description": "stretches where the analysis found the tracked beats half a beat off the tempo map's grid. the grid is on the real beats there, the tracker followed the off-beat. analysis output, edits don't change it",
      "items": {
        "$ref": "#/$defs/OffbeatRun"
      },
      "title": "Offbeat Runs",
      "type": "array"
    },
    "schema_version": {
      "const": "2.3",
      "default": "2.3",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/AudioSource"
    },
    "tempo_map": {
      "items": {
        "$ref": "#/$defs/TempoSegment"
      },
      "minItems": 1,
      "title": "Tempo Map",
      "type": "array"
    },
    "trim": {
      "$ref": "#/$defs/Trim"
    }
  },
  "required": [
    "schema_version",
    "source",
    "trim",
    "tempo_map",
    "meter_map",
    "sections",
    "offbeat_runs",
    "notation_suggestions",
    "edits"
  ],
  "title": "TimingReport",
  "type": "object"
}

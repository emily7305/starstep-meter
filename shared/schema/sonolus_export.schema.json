{
  "$defs": {
    "SonolusBpmChange": {
      "additionalProperties": false,
      "properties": {
        "beat": {
          "minimum": 0,
          "title": "Beat",
          "type": "number"
        },
        "bpm": {
          "exclusiveMinimum": 0,
          "title": "Bpm",
          "type": "number"
        },
        "time_ms": {
          "description": "where the change is on the report's timeline (ffmpeg's decode), before decoder compensation",
          "title": "Time Ms",
          "type": "number"
        }
      },
      "required": [
        "beat",
        "bpm",
        "time_ms"
      ],
      "title": "SonolusBpmChange",
      "type": "object"
    },
    "SonolusDataValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "SonolusDataValue",
      "type": "object"
    },
    "SonolusEntity": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "title": "Archetype",
          "type": "string"
        },
        "data": {
          "items": {
            "$ref": "#/$defs/SonolusDataValue"
          },
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "archetype",
        "data"
      ],
      "title": "SonolusEntity",
      "type": "object"
    },
    "SonolusLevelData": {
      "additionalProperties": false,
      "properties": {
        "bgmOffset": {
          "description": "seconds into the bgm file at level time 0, which is beat 0. the bgm is at level time + bgmOffset",
          "title": "Bgmoffset",
          "type": "number"
        },
        "entities": {
          "description": "one #BPM_CHANGE per tempo, with #BEAT and #BPM. an engine's own entities (initialization, stage, notes) go next to these",
          "items": {
            "$ref": "#/$defs/SonolusEntity"
          },
          "title": "Entities",
          "type": "array"
        }
      },
      "required": [
        "bgmOffset",
        "entities"
      ],
      "title": "SonolusLevelData",
      "type": "object"
    },
    "SonolusTimeSignature": {
      "additionalProperties": false,
      "properties": {
        "beat": {
          "description": "the bar line this signature starts on",
          "minimum": 0,
          "title": "Beat",
          "type": "number"
        },
        "denominator": {
          "maximum": 64,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "minimum": 1,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "beat",
        "numerator",
        "denominator"
      ],
      "title": "SonolusTimeSignature",
      "type": "object"
    }
  },
  "$id": "sonolus_export.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bpm_changes": {
      "description": "the same changes as level_data, with times",
      "items": {
        "$ref": "#/$defs/SonolusBpmChange"
      },
      "minItems": 1,
      "title": "Bpm Changes",
      "type": "array"
    },
    "decoder_compensation_ms": {
      "description": "how much later than ffmpeg's timeline the player's decoder plays the audio, already in bgmOffset",
      "title": "Decoder Compensation Ms",
      "type": "number"
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "filename": {
      "description": "the report's source filename, for display only",
      "title": "Filename",
      "type": "string"
    },
    "first_downbeat_beat": {
      "description": "the beat of tempo_map[0].anchor_ms, the song's first downbeat",
      "minimum": 0,
      "title": "First Downbeat Beat",
      "type": "number"
    },
    "kind": {
      "const": "sonolus",
      "default": "sonolus",
      "title": "Kind",
      "type": "string"
    },
    "level_data": {
      "$ref": "#/$defs/SonolusLevelData"
    },
    "sha256": {
      "description": "the source file the report belongs to",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "time_signatures": {
      "description": "not part of Sonolus level data, which has no time signature archetype. for the chart editor. a bar cut short by a tempo change or a meter split gets its own entry",
      "items": {
        "$ref": "#/$defs/SonolusTimeSignature"
      },
      "minItems": 1,
      "title": "Time Signatures",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "exported_at",
    "filename",
    "sha256",
    "decoder_compensation_ms",
    "first_downbeat_beat",
    "level_data",
    "bpm_changes",
    "time_signatures"
  ],
  "title": "SonolusExport",
  "type": "object"
}
